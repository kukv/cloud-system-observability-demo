<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jp.kukv.product_api.infrastructure.datasource.stock.StockRegisterDummyMapper">
  <insert id="register">
    insert into products.stock (product_id, quantity)
    values (#{id.value}, #{stock.value})
  </insert>
</mapper>
