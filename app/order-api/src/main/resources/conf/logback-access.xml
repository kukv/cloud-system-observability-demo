<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="jp.kukv.order_api.infrastructure._configuration.logging.LogbackAccessIgnoreFilter" />
        <encoder>
            <pattern>LocalTIme:%date{dd/MM/yyyy:HH:mm:ss.SSS} remoteHost:%clientHost host:%v:%localPort reqestUrl:%requestURL status:%statusCode size:%bytesSent elapsedTime:%elapsedTime authorization:%header{Authorization} userAgent:%header{User-Agent} referer:%header{Referer} %elapsedTime eol</pattern>
        </encoder>
    </appender>

    <appender name="STDOUT-FULL" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="jp.kukv.order_api.infrastructure._configuration.logging.LogbackAccessIgnoreFilter" />
        <encoder>
            <pattern>reqestLog: %magenta(%fullRequest) responseLog: %cyan(%fullResponse)</pattern>
        </encoder>
    </appender>

    <appender-ref ref="STDOUT" />
    <appender-ref ref="STDOUT-FULL" />
</configuration>
